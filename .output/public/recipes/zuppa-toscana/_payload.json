[{"data":1,"prerenderedAt":95},["ShallowReactive",2],{"recipe-zuppa-toscana":3},{"id":4,"title":5,"body":6,"description":77,"extension":82,"image":83,"meta":84,"navigation":85,"path":86,"seo":87,"stem":88,"tags":89,"time":93,"__hash__":94},"recipes/recipes/zuppa-toscana.md","Zuppa Toscana",{"type":7,"value":8,"toc":76},"minimark",[9,14,54,58],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33,36,39,42,45,48,51],"ul",{},[18,19,20],"li",{},"6 slices bacon",[18,22,23],{},"1 lb mild pork sausage",[18,25,26],{},"4 cups diced russet potatoes",[18,28,29],{},"1 cup diced white onion",[18,31,32],{},"1/4 tsp salt",[18,34,35],{},"1/4 tsp pepper",[18,37,38],{},"1 tsp dried basil",[18,40,41],{},"1/2 tsp dried thyme",[18,43,44],{},"2 tsp minced garlic",[18,46,47],{},"32 oz chicken broth",[18,49,50],{},"1 1/2 cups heavy cream",[18,52,53],{},"4 cups chopped kale",[10,55,57],{"id":56},"directions","Directions",[59,60,61,64,67,70,73],"ol",{},[18,62,63],{},"Cook the bacon in a skillet over medium-high heat until crisp. Drain and add to the slow cooker. In the same pan, cook and crumble the ground sausage, then add to the slow cooker.",[18,65,66],{},"Add the potatoes, onion, salt, pepper, basil, thyme, garlic, and chicken broth to the slow cooker. Do not add the cream or kale yet.",[18,68,69],{},"Cover and cook on LOW for 7 hours or HIGH for 4 hours.",[18,71,72],{},"When the cooking time is complete, add the heavy cream and chopped kale. Push the kale down into the soup to submerge it.",[18,74,75],{},"Cover and cook for an additional 20 minutes, then serve.",{"title":77,"searchDepth":78,"depth":78,"links":79},"",2,[80,81],{"id":12,"depth":78,"text":13},{"id":56,"depth":78,"text":57},"md","/images/zuppa-toscana.jpg",{},true,"/recipes/zuppa-toscana",{"title":5,"description":77},"recipes/zuppa-toscana",[90,91,92],"soup","slow cooker","Italian",480,"fqXwMVnQsPpL7NVDC0gkQXhhD5Tbk04IzhT4qbaiUyI",1773865814658]