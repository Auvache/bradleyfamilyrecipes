[{"data":1,"prerenderedAt":86},["ShallowReactive",2],{"recipe-kristys-macaroni-and-cheese":3},{"id":4,"title":5,"body":6,"description":68,"extension":73,"image":74,"meta":75,"navigation":76,"path":77,"seo":78,"stem":79,"tags":80,"time":84,"__hash__":85},"recipes/recipes/kristys-macaroni-and-cheese.md","Kristy's Macaroni and Cheese",{"type":7,"value":8,"toc":67},"minimark",[9,14,42,46],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33,36,39],"ul",{},[18,19,20],"li",{},"2 tablespoons cornstarch",[18,22,23],{},"1 teaspoon salt",[18,25,26],{},"1/2 teaspoon dry mustard (optional)",[18,28,29],{},"1/4 teaspoon pepper",[18,31,32],{},"2 1/2 cups milk",[18,34,35],{},"2 tablespoons margarine or butter",[18,37,38],{},"2 cups (8 oz) shredded American or cheddar cheese, divided",[18,40,41],{},"8 ounces elbow macaroni (about 2 cups dry), cooked 5 minutes and drained",[10,43,45],{"id":44},"directions","Directions",[47,48,49,52,55,58,61,64],"ol",{},[18,50,51],{},"Preheat oven to 375°F.",[18,53,54],{},"In a medium saucepan, combine cornstarch, salt, dry mustard, and pepper. Stir in milk.",[18,56,57],{},"Add margarine. Stirring constantly, bring to a boil over medium-high heat and boil 1 minute.",[18,59,60],{},"Remove from heat. Stir in 1 3/4 cups cheese until melted.",[18,62,63],{},"Add the cooked elbows. Pour into a greased 2-quart casserole. Sprinkle with reserved cheese.",[18,65,66],{},"Bake uncovered 25 minutes or until lightly browned.",{"title":68,"searchDepth":69,"depth":69,"links":70},"",2,[71,72],{"id":12,"depth":69,"text":13},{"id":44,"depth":69,"text":45},"md","/images/kristys-macaroni-and-cheese.jpg",{},true,"/recipes/kristys-macaroni-and-cheese",{"title":5,"description":68},"recipes/kristys-macaroni-and-cheese",[81,82,83],"pasta","casserole","comfort food",45,"nV4ntoLmnhV4iFFM1FAINuyLxogImLH5UVNEoxFAkDQ",1773865814657]