[{"data":1,"prerenderedAt":105},["ShallowReactive",2],{"recipe-creamy-pumpkin-soup":3},{"id":4,"title":5,"body":6,"description":84,"extension":92,"image":93,"meta":94,"navigation":95,"path":96,"seo":97,"stem":98,"tags":99,"time":103,"__hash__":104},"recipes/recipes/creamy-pumpkin-soup.md","Creamy Pumpkin Soup",{"type":7,"value":8,"toc":83},"minimark",[9,14,51,56,61,65],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33,36,39,42,45,48],"ul",{},[18,19,20],"li",{},"2 cups finely chopped onions",[18,22,23],{},"1/2 cup finely chopped celery",[18,25,26],{},"1/4 cup butter",[18,28,29],{},"16 oz solid pack pumpkin",[18,31,32],{},"1 teaspoon ground cumin",[18,34,35],{},"Salt and pepper to taste",[18,37,38],{},"2 green onions, finely sliced",[18,40,41],{},"1 green chili pepper, diced",[18,43,44],{},"3 (14 oz) cans chicken stock",[18,46,47],{},"1 bay leaf",[18,49,50],{},"1 cup evaporated milk",[52,53,55],"h3",{"id":54},"garnish","Garnish",[15,57,58],{},[18,59,60],{},"Parmesan cheese and chopped parsley, or sour cream and toasted pumpkin seeds",[10,62,64],{"id":63},"directions","Directions",[66,67,68,71,74,77,80],"ol",{},[18,69,70],{},"Saute onion, green onions, celery, and chili pepper in butter. Cook until onions begin to look translucent.",[18,72,73],{},"Add broth, pumpkin, bay leaf, and cumin. Bring to a simmer. Simmer uncovered about 20 minutes or a little longer.",[18,75,76],{},"Remove bay leaf. Add evaporated milk and cook over low heat for 5 minutes. Be careful not to boil.",[18,78,79],{},"Taste and adjust seasoning if necessary. Transfer to your favorite soup tureen.",[18,81,82],{},"Garnish with grated parmesan cheese and chopped parsley, or with sour cream and toasted pumpkin seeds.",{"title":84,"searchDepth":85,"depth":85,"links":86},"",2,[87,91],{"id":12,"depth":85,"text":13,"children":88},[89],{"id":54,"depth":90,"text":55},3,{"id":63,"depth":85,"text":64},"md","/images/creamy-pumpkin-soup.webp",{},true,"/recipes/creamy-pumpkin-soup",{"t