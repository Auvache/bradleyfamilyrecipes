[{"data":1,"prerenderedAt":105},["ShallowReactive",2],{"recipe-spicy-pork-chicken-chili":3},{"id":4,"title":5,"body":6,"description":86,"extension":91,"image":92,"meta":93,"navigation":94,"path":95,"seo":96,"stem":97,"tags":98,"time":103,"__hash__":104},"recipes/recipes/spicy-pork-chicken-chili.md","Spicy Pork/Chicken Chili",{"type":7,"value":8,"toc":85},"minimark",[9,14,63,67],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33,36,39,42,45,48,51,54,57,60],"ul",{},[18,19,20],"li",{},"1.5 lbs pork tenderloin or chicken, cubed",[18,22,23],{},"2 large onions, diced",[18,25,26],{},"4 celery ribs, diced",[18,28,29],{},"2 tablespoons butter",[18,31,32],{},"6 cans (15.5 oz each) great northern beans, rinsed and drained",[18,34,35],{},"4 cans (14.5 oz each) chicken broth",[18,37,38],{},"2 cups water",[18,40,41],{},"2 jalapeno peppers, seeded and chopped",[18,43,44],{},"2 teaspoons chili powder",[18,46,47],{},"1/2 teaspoon each white pepper, cayenne pepper, ground cumin, and pepper",[18,49,50],{},"2 garlic cloves, minced",[18,52,53],{},"1/2 teaspoon salt",[18,55,56],{},"1/4 teaspoon dried parsley flakes (or chopped celery leaves)",[18,58,59],{},"1/4 teaspoon hot pepper sauce (optional)",[18,61,62],{},"1 cup shredded monterey jack cheese",[10,64,66],{"id":65},"directions","Directions",[68,69,70,73,76,79,82],"ol",{},[18,71,72],{},"In a large pot, cook the pork, onions, and celery in butter until meat is browned.",[18,74,75],{},"Stir in the beans, chicken broth, water, jalapeno peppers, chili powder, white pepper, cayenne pepper, ground cumin, pepper, garlic, salt, parsley flakes, and hot pepper sauce. Bring to a boil.",[18,77,78],{},"Reduce heat, cover and simmer for 1.5 hours.",[18,80,81],{},"Uncover and simmer 30-40 minutes longer or until chili reaches desired consistency.",[18,83,84],{},"Sprinkle with cheese and serve.",{"title":86,"searchDepth":87,"depth":87,"links":88},"",2,[89,90],{"id":12,"depth":87,"text":13},{"id":65,"depth":87,"text":66},"md","/images/spicy-pork-chicken-chili.jpg",{},true,"/recipes/spicy-pork-chicken-chili",{"title":5,"description":86},"recipes/spicy-pork-chicken-chili",[99,100,101,102],"chili","pork","chicken","spicy",165,"YWKpi_kpUym9xbWA6-kynBSRaVd0hJeEMT2WmVEYod8",1780084451586]