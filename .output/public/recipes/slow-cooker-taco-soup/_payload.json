[{"data":1,"prerenderedAt":115},["ShallowReactive",2],{"recipe-slow-cooker-taco-soup":3},{"id":4,"title":5,"body":6,"description":94,"extension":103,"image":104,"meta":105,"navigation":106,"path":107,"seo":108,"stem":109,"tags":110,"time":113,"__hash__":114},"recipes/recipes/slow-cooker-taco-soup.md","Easy Slow Cooker Taco Soup",{"type":7,"value":8,"toc":93},"minimark",[9,14,19,56,60,77,81],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,18],"h3",{"id":17},"soup","Soup",[20,21,22,26,29,32,35,38,41,44,47,50,53],"ul",{},[23,24,25],"li",{},"1 lb lean ground beef",[23,27,28],{},"1 medium onion, chopped",[23,30,31],{},"2 garlic cloves, minced",[23,33,34],{},"2 (14.5 oz) cans fire roasted tomatoes",[23,36,37],{},"1 (15 oz) can chili beans",[23,39,40],{},"1 (15 oz) can black beans, drained and rinsed",[23,42,43],{},"1 (8 oz) can tomato sauce",[23,45,46],{},"1 (4 oz) can diced green chiles",[23,48,49],{},"1 cup frozen corn",[23,51,52],{},"1 (1 oz) packet taco seasoning",[23,54,55],{},"2 cups low sodium chicken broth",[15,57,59],{"id":58},"optional-toppings","Optional Toppings",[20,61,62,65,68,71,74],{},[23,63,64],{},"Shredded Mexican blend cheese",[23,66,67],{},"Sour cream",[23,69,70],{},"Corn chips",[23,72,73],{},"Chopped cilantro",[23,75,76],{},"Chopped avocado",[10,78,80],{"id":79},"directions","Directions",[82,83,84,87,90],"ol",{},[23,85,86],{},"Crumble ground beef in a large nonstick skillet over medium-high heat. Add the onions and garlic, and cook until beef is browned and onions are soft, about 5 minutes. Drain grease.",[23,88,89],{},"Transfer the cooked meat to the bowl of your slow cooker (6 quarts). Add in the fire roasted tomatoes, chili beans, black beans, tomato sauce, green chiles, corn, taco seasoning, and chicken broth. Stir everything well.",[23,91,92],{},"Place the lid on top and cook the soup for 6-8 hours over low heat, or 3-4 hours on high heat. Serve with optional toppings sprinkled on top of each bowl of soup.",{"title":94,"searchDepth":