[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"recipe-homemade-playdough":3},{"id":4,"title":5,"body":6,"description":59,"extension":64,"image":65,"meta":66,"navigation":67,"path":68,"seo":69,"stem":70,"tags":71,"time":75,"__hash__":76},"recipes/recipes/homemade-playdough.md","Homemade Playdough",{"type":7,"value":8,"toc":58},"minimark",[9,14,36,40],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33],"ul",{},[18,19,20],"li",{},"1/2 cup boiling water",[18,22,23],{},"1/2 cup flour",[18,25,26],{},"1 teaspoon cream of tartar",[18,28,29],{},"1/4 cup salt",[18,31,32],{},"1 1/2 teaspoons canola oil",[18,34,35],{},"1 pack Kool-Aid or 4-5 drops of food coloring",[10,37,39],{"id":38},"directions","Directions",[41,42,43,46,49,52,55],"ol",{},[18,44,45],{},"Combine water and food coloring in a pot and bring to a boil.",[18,47,48],{},"While waiting for the water to boil, combine your dry ingredients in a separate bowl.",[18,50,51],{},"Remove from heat and add the oil.",[18,53,54],{},"Slowly stir in the dry ingredients. Continue mixing until the playdough forms a ball.",[18,56,57],{},"When the playdough is cool enough, knead it until it is no longer sticky. Flour your hands first to prevent sticking.",{"title":59,"searchDepth":60,"depth":60,"links":61},"",2,[62,63],{"id":12,"depth":60,"text":13},{"id":38,"depth":60,"text":39},"md","/images/homemade-playdough.webp",{},true,"/recipes/homemade-playdough",{"title":5,"description":59},"recipes/homemade-playdough",[72,73,74],"kids","crafts","non-food",15,"1zUXEGkoDI9hFTcvH8snQj4_s5Nzx0XeUTXXxMvPQGQ",1780084451584]