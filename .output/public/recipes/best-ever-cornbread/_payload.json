[{"data":1,"prerenderedAt":95},["ShallowReactive",2],{"recipe-best-ever-cornbread":3},{"id":4,"title":5,"body":6,"description":77,"extension":82,"image":83,"meta":84,"navigation":85,"path":86,"seo":87,"stem":88,"tags":89,"time":93,"__hash__":94},"recipes/recipes/best-ever-cornbread.md","The Best Ever Cornbread",{"type":7,"value":8,"toc":76},"minimark",[9,14,48,52],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33,36,39,42,45],"ul",{},[18,19,20],"li",{},"1 cup corn meal",[18,22,23],{},"2 cups flour",[18,25,26],{},"1 1/4 cups sugar",[18,28,29],{},"1 tablespoon baking powder",[18,31,32],{},"1/2 teaspoon salt",[18,34,35],{},"3/4 cup melted butter",[18,37,38],{},"1 can evaporated milk",[18,40,41],{},"1 teaspoon vanilla",[18,43,44],{},"4 large eggs",[18,46,47],{},"1/4 cup melted butter (for topping)",[10,49,51],{"id":50},"directions","Directions",[53,54,55,58,61,64,67,70,73],"ol",{},[18,56,57],{},"Preheat oven to 350°F. Grease a 9x13 pan.",[18,59,60],{},"Combine dry ingredients (corn meal, flour, sugar, baking powder, salt) in a large bowl. Mix well.",[18,62,63],{},"Separate the eggs. Beat egg whites until fluffy.",[18,65,66],{},"In a separate bowl, combine egg yolks, evaporated milk, vanilla, and 3/4 cup melted butter. Mix well.",[18,68,69],{},"Add the wet mixture to the dry ingredients. Fold in the egg whites.",[18,71,72],{},"Bake in the greased 9x13 pan at 350°F for 30 minutes.",[18,74,75],{},"While still warm, pour 1/4 cup melted butter over the top (optional).",{"title":77,"searchDepth":78,"depth":78,"links":79},"",2,[80,81],{"id":12,"depth":78,"text":13},{"id":50,"depth":78,"text":51},"md","/images/best-ever-cornbread.jpg",{},true,"/recipes/best-ever-cornbread",{"title":5,"description":77},"recipes/best-ever-cornbread",[90,91,92],"bread","baking","side dish",45,"wcdTz5f2pK5cs1CCVouZSBV1LXHdhcJblX54sKkxMU8",1780084451586]