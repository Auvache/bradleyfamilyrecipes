[{"data":1,"prerenderedAt":86},["ShallowReactive",2],{"recipe-hawaiian-macaroni-salad":3},{"id":4,"title":5,"body":6,"description":68,"extension":73,"image":74,"meta":75,"navigation":76,"path":77,"seo":78,"stem":79,"tags":80,"time":84,"__hash__":85},"recipes/recipes/hawaiian-macaroni-salad.md","Authentic Hawaiian Macaroni Salad",{"type":7,"value":8,"toc":67},"minimark",[9,14,45,49],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33,36,39,42],"ul",{},[18,19,20],"li",{},"1 pound macaroni",[18,22,23],{},"2 tablespoons apple cider vinegar",[18,25,26],{},"2 carrots, shredded",[18,28,29],{},"1/4 cup shredded onion (optional)",[18,31,32],{},"2 1/2 cups mayonnaise (Best Foods or Hellman's)",[18,34,35],{},"1/4 cup milk",[18,37,38],{},"2 teaspoons sugar",[18,40,41],{},"Kosher salt to taste",[18,43,44],{},"Ground black pepper to taste",[10,46,48],{"id":47},"directions","Directions",[50,51,52,55,58,61,64],"ol",{},[18,53,54],{},"Cook macaroni according to package directions. Rinse under cold water until completely cool. Drain well and place in a large bowl.",[18,56,57],{},"Sprinkle on vinegar. Add carrot and onion. Toss together until well combined. Refrigerate for 15 minutes, or until cooled.",[18,59,60],{},"In a separate small bowl, whisk together mayo, milk, and sugar. Fold the mayo mixture into the macaroni until all the noodles are evenly coated. Add salt and pepper to taste.",[18,62,63],{},"Cover and refrigerate for at least 4 hours (best if overnight).",[18,65,66],{},"Gently stir before serving, add a little more milk if needed, no more than a tablespoon or two.",{"title":68,"searchDepth":69,"depth":69,"links":70},"",2,[71,72],{"id":12,"depth":69,"text":13},{"id":47,"depth":69,"text":48},"md","/images/hawaiian-macaroni-salad.webp",{},true,"/recipes/hawaiian-macaroni-salad",{"title":5,"description":68},"recipes/hawaiian-macaroni-salad",[81,82,83],"salad","side dish","Hawaiian",285,"4JFe74TbLzxGNMxER_o5QHU1YGDU5mbvSinhB5cmSyA",1780084451580]