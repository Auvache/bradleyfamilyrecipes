[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"recipe-bryces-cream-cheese-chicken-chili":3},{"id":4,"title":5,"body":6,"description":65,"extension":70,"image":71,"meta":72,"navigation":73,"path":74,"seo":75,"stem":76,"tags":77,"time":81,"__hash__":82},"recipes/recipes/bryces-cream-cheese-chicken-chili.md","Bryce's Cream Cheese Chicken Chili",{"type":7,"value":8,"toc":64},"minimark",[9,14,45,49],[10,11,13],"h2",{"id":12},"ingredients","Ingredients",[15,16,17,21,24,27,30,33,36,39,42],"ul",{},[18,19,20],"li",{},"2 frozen chicken breasts",[18,22,23],{},"1 can black beans, drained and rinsed",[18,25,26],{},"1 can corn, do not drain",[18,28,29],{},"1 can Rotel tomatoes and chilies",[18,31,32],{},"1 tablespoon cumin",[18,34,35],{},"1 teaspoon chili powder",[18,37,38],{},"1 teaspoon onion powder",[18,40,41],{},"1 Ranch dressing packet",[18,43,44],{},"1 package (8 oz) cream cheese",[10,46,48],{"id":47},"directions","Directions",[50,51,52,55,58,61],"ol",{},[18,53,54],{},"Put the chicken breasts in the crock pot, then add the other ingredients on top.",[18,56,57],{},"Turn crock pot on low and cook for about 4-5 hours, stirring a couple times to mix in the cream cheese.",[18,59,60],{},"Shred the chicken and serve. Makes about 2 quarts of chili.",[18,62,63],{},"For best results, let the chili sit overnight in the fridge and reheat the next day to serve.",{"title":65,"searchDepth":66,"depth":66,"links":67},"",2,[68,69],{"id":12,"depth":66,"text":13},{"id":47,"depth":66,"text":48},"md","/images/bryces-cream-cheese-chicken-chili.jpg",{},true,"/recipes/bryces-cream-cheese-chicken-chili",{"title":5,"description":65},"recipes/bryces-cream-cheese-chicken-chili",[78,79,80],"crockpot","chicken","chili",300,"8KS7zUJTd0MGAxsiu6apY9NyWHnTvF2dT-bWHoAiDGQ",1773865814654]